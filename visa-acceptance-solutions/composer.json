{
    "name": "woocommerce/visa-acceptance-solutions",
    "description": "Take Unified Checkout payments on your store using Visa Acceptance Solutions.",
    "type": "composer-plugin",
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/installers": true
        }
    },
    "require": {
        "php": "^8.2",
        "composer-plugin-api": "^2.0",
        "cybersource/rest-client-php": "0.0.76",
        "monolog/monolog": "^2.0",
        "phpseclib/phpseclib": "3.0.57" 
    },
    "require-dev": {
        "composer/installers": "^2.0",
        "coenjacobs/mozart": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "WC_Vas_Gateway\\": "includes/"
        }
    },
    "scripts": {
        "mozart-compose": "mozart compose"
    },
    "extra": {
        "installer-disable": true,
        "mozart": {
            "dep_namespace": "Pymt_Vas\\Dependencies\\",
            "dep_directory": "/vendor-prefixed/",
            "classmap_directory": true,
            "classmap_prefix": "Pymt_Vas_",
            "constant_prefix": "Pymt_Vas_",
            "functions_prefix": "pymt_vas_",
            "generate_autoloader": true,
            "delete_vendor_directories": false,
            "updateCallSites": true,
            "case_sensitive": true
        }
    }
}
